# ── Variáveis públicas (vão para o navegador; nunca coloque segredo aqui) ──
# URL pública do site, https e sem barra no final. Liga canonical, og:url, sitemap e dados estruturados.
VITE_SITE_URL=

# Para onde o formulário envia o pedido de cotação.
#   vazio          → abre o WhatsApp com a mensagem pronta (padrão, sem servidor)
#   /api/cotacao   → função de servidor deste projeto (Vercel), recomendado
VITE_QUOTE_ENDPOINT=

# ── Variáveis de servidor (configure no painel da hospedagem, NUNCA com prefixo VITE_) ──
# Endereço do CRM / Make / Zapier que recebe as cotações. Só a função api/cotacao.ts lê.
QUOTE_WEBHOOK_URL=
# Opcional: token enviado como "Authorization: Bearer ..." para o webhook.
QUOTE_WEBHOOK_TOKEN=
# Opcional: origens aceitas, separadas por vírgula (ex.: https://liderprev.com.br,https://www.liderprev.com.br)
ALLOWED_ORIGINS=
